{
  "name": "mindnode-mcp",
  "version": "0.1.0",
  "description": "MCP server for MindNode (macOS) — read the MindNode Next library, create and open mind maps",
  "type": "module",
  "bin": {
    "mindnode-mcp": "src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.ts",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  }
}
