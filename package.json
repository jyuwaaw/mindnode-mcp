{
  "name": "mindnode-mcp",
  "version": "0.1.0",
  "description": "MCP server for MindNode (macOS): connect Claude and AI agents to the mind-mapping app with no API — read mind maps as Markdown, create maps from outlines",
  "type": "module",
  "license": "MIT",
  "author": "jyuwaaw <jyuwaaw@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyuwaaw/mindnode-mcp.git"
  },
  "homepage": "https://github.com/jyuwaaw/mindnode-mcp#readme",
  "bugs": "https://github.com/jyuwaaw/mindnode-mcp/issues",
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "mindnode",
    "mind-map",
    "mindmap",
    "macos",
    "claude",
    "ai-agent",
    "automation",
    "reverse-engineering"
  ],
  "os": [
    "darwin"
  ],
  "bin": {
    "mindnode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.ts",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
